# Copy to .env next to docker-compose.yml. Every setting is optional.
# Docker Compose reads this file; a server started with uvicorn reads
# backend/.env and the shell environment instead.

# Port on the host.
# COASTMATH_PORT=8000

# Address the host listens on. 127.0.0.1 is this machine only; 0.0.0.0 opens the
# port to the network, which belongs behind HTTPS (see README).
# COASTMATH_BIND=127.0.0.1

# Sessions and stored bank credentials use secrets generated on first start
# (kept in the data volume). Set them here only to manage them yourself:
# SESSION_SECRET=           # at least 32 random characters
# LEDGER_ENCRYPTION_KEY=    # at least 32 random characters
# LEDGER_ENCRYPTION_KEYS_PREVIOUS=

# Set to true once CoastMath is served over HTTPS.
# SESSION_COOKIE_SECURE=false

# Other origins allowed to call the API with cookies, comma-separated
# (e.g. a separate development server). The serving origin is always allowed;
# "*" and "null" are refused.
# ALLOWED_ORIGINS=http://localhost:3000

# Behind a reverse proxy: the proxy addresses whose X-Forwarded-* headers to trust,
# as the container sees them (a proxy on this machine arrives from the Docker
# bridge, e.g. 172.17.0.1).
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# Server processes. SQLite allows one writer at a time.
# WEB_CONCURRENCY=1

# Projections each process runs at once; more are refused with 429.
# ENGINE_CONCURRENCY=4

# Serve the OpenAPI schema at /openapi.json and /docs.
# ENABLE_API_DOCS=true

# Reported as "revision" by GET /api/ready, e.g. the commit you deployed.
# APP_REVISION=

# Extension modules to load at startup, comma-separated. Unset or empty loads none.
# COASTMATH_PLUGINS=

# Mount the stateless projection routes (POST /api/simulate/stateless and
# /api/compare/stateless, a whole plan in the body). Local tooling and tests
# only; they run with no session.
# ENABLE_STATELESS_API=false

# Transactions: file import works with no keys.
# TRANSACTIONS_ENABLED=true

# SimpleFIN: each user pastes their own setup token.
# SIMPLEFIN_ENABLED=true
# SIMPLEFIN_ALLOWED_HOSTS=beta-bridge.simplefin.org,bridge.simplefin.org

# Plaid, with your own keys from the Plaid Dashboard.
# PLAID_ENABLED=true
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_COUNTRY_CODES=US
# PLAID_REDIRECT_URI=https://your-host/plaid/oauth
# PLAID_WEBHOOK_URL=https://your-host/api/ledger/webhooks/plaid

# Category suggestions from any OpenAI-compatible endpoint, hosted or local.
# host.docker.internal is this machine, seen from the container.
# LEDGER_LLM_ENABLED=true
# LEDGER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LEDGER_LLM_MODEL=
# LEDGER_LLM_API_KEY=
# LEDGER_LLM_TIMEOUT_SECONDS=30

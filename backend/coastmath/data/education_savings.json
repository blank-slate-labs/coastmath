      "section": "Federal",
      "content": [
        {
          "field": "Qualified distributions",
          "value": "Excluded from income up to qualified higher education expenses",
          "source": "IRC 529(c)(3)(B) (https://www.law.cornell.edu/uscode/text/26/529); IRS Pub. 970, ch. 7 (https://www.irs.gov/publications/p970)"
        },
        {
          "field": "Nonqualified distributions",
          "value": "Earnings share is income under the annuity rules of IRC 72; basis is recovered pro rata",
          "source": "IRC 529(c)(3)(A) (https://www.law.cornell.edu/uscode/text/26/529); IRS Pub. 970, ch. 7 \"Taxable Distributions\" (https://www.irs.gov/publications/p970)"
        },
        {
          "field": "`nonqualified_additional_tax_rate`",
          "value": "10% of the earnings included in income",
          "source": "IRC 529(c)(6) (https://www.law.cornell.edu/uscode/text/26/529), applying IRC 530(d)(4) (https://www.law.cornell.edu/uscode/text/26/530); IRS Pub. 970, ch. 7 \"Additional Tax on Taxable Distributions\" (https://www.irs.gov/publications/p970)"
        },
        {
          "field": "Estate",
          "value": "A 529 account is not in the owner's gross estate",
          "source": "IRC 529(c)(4)(A) (https://www.law.cornell.edu/uscode/text/26/529)"
        }
      ]
    },
    {
